{
  "manifest_version": 3,
  "name": "J-PlatPat 验证码助手",
  "version": "0.3.1",
  "description": "J-PlatPat 验证码自动识别、自动提交，PDF 直接下载到本地（不弹查看器窗口）。模型在本地运行，不联网。",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://*.j-platpat.inpit.go.jp/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.j-platpat.inpit.go.jp/*"],
      "js": ["page_hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.j-platpat.inpit.go.jp/*"],
      "js": ["model.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["model/*"], "matches": ["https://*.j-platpat.inpit.go.jp/*"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "J-PlatPat 验证码助手" }
}
